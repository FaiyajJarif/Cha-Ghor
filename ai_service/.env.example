# Copy to .env and adjust. Leave GEMINI_API_KEY blank to run Ollama-only.

# ---- Database (read-only role; see sql/ai_readonly_setup.sql) ----
AI_DB_HOST=localhost
AI_DB_PORT=5433
AI_DB_NAME=chaghor
AI_DB_USER=chabot_readonly
AI_DB_PASSWORD=chabot_readonly_pw
AI_MAX_ROWS=200

# ---- Ollama (local, free) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_VISION_MODEL=llama3.2-vision

# ---- Gemini (free tier) ----
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-1.5-flash

# ---- Per-task routing (fallback is always the other provider) ----
# text2sql sees only the schema (safe for cloud); answer sees real rows (keep local).
ROUTE_TEXT2SQL=gemini
ROUTE_ANSWER=ollama
ROUTE_EXTRACT=gemini
LLM_TIMEOUT_SECONDS=60

# Copy to .env to point the frontend at a backend other than localhost.
# Vite only exposes variables prefixed with VITE_, and inlines them at BUILD
# time -- restart `npm run dev` after changing anything here.
#
# Leave the file absent entirely and everything defaults to localhost, so a
# normal `npm run dev` needs no setup.

# Base URL of the Spring backend, including /api/v1.
# Demoing from another machine? Use the host's LAN IP, not localhost:
#   VITE_API_URL=http://192.168.1.20:8080/api/v1
VITE_API_URL=http://localhost:8080/api/v1

# The two WebSocket URLs are derived from VITE_API_URL automatically
# (http -> ws, https -> wss, /api/v1 stripped), so you normally do NOT need
# these. Set them only if the sockets live on a different host.
# VITE_WS_URL=ws://localhost:8080/ws/notifications
# VITE_SUPPLY_WS_URL=ws://localhost:8080/ws/supply

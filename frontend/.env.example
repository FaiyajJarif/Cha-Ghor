# YOU PROBABLY DO NOT NEED THIS FILE.
#
# src/lib/config.js now derives the backend address from whatever address the
# page was opened at. Open the app at http://192.168.0.108:5173 on a phone and
# it calls http://192.168.0.108:8080/api/v1 by itself -- no file to edit, and
# nothing to re-edit when the router hands out a different IP tomorrow.
#
# Copy this to .env ONLY when the backend is not on the same machine that is
# serving the frontend.
#
# Vite inlines VITE_ variables at BUILD time, so restart `npm run dev` after
# changing anything here.

# Base URL of the Spring backend, including /api/v1.
# VITE_API_URL=http://192.168.0.108:8080/api/v1

# The WebSocket URLs are derived from VITE_API_URL automatically
# (http -> ws, https -> wss, /api/v1 stripped), so you normally do NOT need
# these. Set them only if the sockets live on a different host.
# VITE_WS_URL=ws://192.168.0.108:8080/ws/notifications
# VITE_SUPPLY_WS_URL=ws://192.168.0.108:8080/ws/supply

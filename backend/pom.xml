<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.1</version>
        <relativePath/>
    </parent>

    <groupId>com.chaghor</groupId>
    <artifactId>backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>cha-ghor-backend</name>
    <description>Cha Ghor Tea Garden Management System - backend</description>

    <properties>
        <java.version>17</java.version>

        <!-- ================================================================
             Surefire tag filtering, driven by PROPERTIES rather than by
             overriding the plugin config inside the profile.
             ================================================================
             The first attempt put <excludedGroups>selenium</excludedGroups> in
             the base build and tried to clear it from the profile with an empty
             <excludedGroups/>. Maven MERGES a profile plugin configuration into
             the base one, and an empty element does not reliably erase an
             inherited value, so the build ended up both including and excluding
             the same tag. Surefire then matched nothing and reported, cheerfully,
             "Tests run: 0" with BUILD SUCCESS. A green build that ran no tests
             is the worst possible failure mode: it looks like everything passed.

             Properties have no merge ambiguity. The profile just sets them.
        -->
        <surefire.groups/>
        <surefire.excludedGroups>selenium</surefire.excludedGroups>

        <!-- ================================================================
             SELENIUM VERSION, SET AS A PROPERTY. THIS MATTERS.
             ================================================================
             selenium-java is an AGGREGATOR pom: it pulls selenium-api,
             selenium-remote-driver, selenium-chrome-driver, selenium-safari-
             driver and more.

             Declaring <version>4.47.0</version> on the aggregator alone put
             4.47.0 on the classpath but left every MODULE under it pinned to
             whatever spring-boot-dependencies manages, which is 4.25.0 for
             Boot 3.4.1. (No double hyphens in here. See the surefire comment.)
             The proof was in a test run: Selenium printed
             "Build info: version: '4.25.0'" while the pom said 4.47.0. A
             mismatched aggregator and modules is the kind of thing that works
             until one class moves between artifacts.

             spring-boot-dependencies drives all of them from this property, so
             setting it here keeps the whole set on one version. The dependency
             below deliberately carries NO <version> now: one source of truth.
        -->
        <selenium.version>4.47.0</selenium.version>
    </properties>

    <dependencies>
        <!-- Web (REST API) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Persistence (JPA / Hibernate) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Validation (@Valid on DTOs) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Security + JWT auth -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.30</version>
            <scope>provided</scope>
        </dependency>

        <!-- MapStruct (entity <-> DTO mapping) -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>1.6.3</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>1.6.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- PostgreSQL driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.3</version>
        </dependency>

        <!-- Flyway (runs V1__init.sql automatically on startup) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
            <version>10.22.0</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- JWT (jjwt) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.5</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.5</version>
            <scope>runtime</scope>
        </dependency>

        <!-- websockt -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ================================================================
             SELENIUM - browser tests for the CSE-3412 testing requirement.
             ================================================================
             test scope, so it is never packaged into the running application.

             4.6+ ships Selenium Manager, which downloads a chromedriver
             matching the installed Chrome by itself. Do NOT add WebDriverManager
             or commit a chromedriver binary; both exist in older tutorials and
             both are now a source of version-mismatch failures rather than a
             cure for them.

             These tests are EXCLUDED from `./mvnw test` by the surefire config
             below, because they need Chrome plus a running backend and Vite.
             Run them deliberately:  ./mvnw test -Pselenium
        -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <!-- Version comes from the selenium.version property above, which
                 spring-boot-dependencies applies to every selenium module.
                 Do not put a <version> back here: it would pin the aggregator
                 while leaving the modules behind. -->
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiler: Lombok + MapStruct annotation processors -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>1.18.30</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>1.6.3</version>
                        </path>
                        <!-- lombok-mapstruct-binding avoids NPEs when both run together -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- ============================================================
                 SUREFIRE: keep browser tests OUT of the normal build.
                 ============================================================
                 The Selenium classes are tagged @Tag("selenium"). Excluding
                 that tag by default means `./mvnw test` and any CI build stay
                 fast and headless-safe: they need no Chrome, no Vite and no
                 backend on :8080.

                 Without this, every `./mvnw spring-boot:run` preceded by a test
                 phase would try to open a browser and fail on a machine that
                 has none, which looks like a broken build rather than a
                 missing browser. The `selenium` profile below flips it.

                 (Note for anyone editing these comments: a double hyphen is
                 ILLEGAL inside an XML comment. Writing an em dash as two
                 hyphens here makes the whole pom unparseable, and Maven then
                 reports a malformed POM rather than a comment problem.) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <groups>${surefire.groups}</groups>
                    <excludedGroups>${surefire.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>

            <!-- Optional: run `mvn flyway:migrate` manually against the running DB.
                 Not required for normal runs (flyway-core auto-runs at app startup
                 using application.yml). Kept here only for manual/CI use. -->
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>10.22.0</version>
                <configuration>
                    <url>jdbc:postgresql://localhost:5433/chaghor</url>
                    <user>chaghor</user>
                    <password>chaghor_dev_pw</password>
                    <schemas>
                        <schema>public</schema>
                    </schemas>
                    <cleanDisabled>false</cleanDisabled>
                </configuration>
            </plugin>

            <!-- Spring Boot packaging + `spring-boot:run` -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- ====================================================================
         ./mvnw test -Pselenium     run ONLY the browser tests
         ./mvnw test                run everything else, no browser needed
         ====================================================================
         `groups` selects the tag instead of excluding it, so this profile runs
         the Selenium suite and nothing else. The empty <excludedGroups/> is
         required: a profile adds to the base configuration rather than
         replacing it, so without clearing it the build would both include and
         exclude the same tag and silently run zero tests.

         Chrome opens visibly by default. Add -Dselenium.headless=true for CI or
         over SSH. -->
    <profiles>
        <profile>
            <id>selenium</id>
            <properties>
                <!-- Include the tag, and clear the exclusion. Setting the two
                     properties is unambiguous; overriding the plugin config
                     from here was not. See the note beside their defaults. -->
                <surefire.groups>selenium</surefire.groups>
                <surefire.excludedGroups/>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <!-- One browser at a time. These tests share one
                                 database and one estate: running them in
                                 parallel would have two of them settling and
                                 generating payroll over each other. Safari also
                                 permits only ONE WebDriver session at a time, so
                                 this is a hard requirement there, not a
                                 preference. -->
                            <forkCount>1</forkCount>
                            <reuseForks>true</reuseForks>
                            <!-- Surefire skips the whole run, quietly, when a
                                 tag filter matches nothing. Fail instead: a
                                 green build that ran zero tests is worse than a
                                 red one, because nobody investigates green. -->
                            <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
